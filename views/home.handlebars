<div class="row">
    <div class="col-md-8 mx-auto text-center">
        <div class="card">
            <div class="card-body py-5">
                <h1 class="display-4 text-primary mb-4">
                    <i class="fas fa-calendar-check"></i> {{title}}
                </h1>
                <p class="lead mb-4">{{mensaje}}</p>
                <p class="text-muted mb-5">
                    Sistema completo para gestionar turnos y citas de manera eficiente.
                    Reserva, consulta, modifica y cancela turnos fácilmente.
                </p>
                
                <div class="row g-3">
                    <div class="col-md-6">
                        <a href="/turnos/reservar" class="btn btn-success btn-lg w-100">
                            <i class="fas fa-plus me-2"></i>Reservar Turno
                        </a>
                    </div>
                    <div class="col-md-6">
                        <a href="/turnos" class="btn btn-info btn-lg w-100">
                            <i class="fas fa-list me-2"></i>Ver Turnos
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Contador de turnos -->
<div class="row mt-4">
    <div class="col-md-6 mx-auto">
        <div class="card text-center bg-primary text-white">
            <div class="card-body">
                <h2 class="card-title" id="turnos-count">-</h2>
                <p class="card-text" id="turnos-text">Cargando turnos...</p>
                <i class="fas fa-calendar-check fa-2x"></i>
            </div>
        </div>
    </div>
</div>

<div class="row mt-5">
    <div class="col-md-4">
        <div class="card h-100 home-card">
            <div class="card-body text-center">
                <i class="fas fa-clock fa-3x text-primary mb-3"></i>
                <h5 class="card-title">Reservar Turnos</h5>
                <p class="card-text">Programa tus citas de manera rápida y sencilla.</p>
                <a href="/turnos/reservar" class="btn btn-primary">Ir a Reservar</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 home-card">
            <div class="card-body text-center">
                <i class="fas fa-edit fa-3x text-success mb-3"></i>
                <h5 class="card-title">Gestionar Turnos</h5>
                <p class="card-text">Modifica o cancela tus turnos cuando lo necesites.</p>
                <a href="/turnos" class="btn btn-success">Ver Turnos</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 home-card">
            <div class="card-body text-center">
                <i class="fas fa-envelope fa-3x text-warning mb-3"></i>
                <h5 class="card-title">Contacto</h5>
                <p class="card-text">Envía un mensaje o consulta directamente.</p>
                <a href="/contacto" class="btn btn-warning">Ir a Contacto</a>
            </div>
        </div>
    </div>
</div>

<script>
// Contador de turnos con JavaScript vanilla
document.addEventListener('DOMContentLoaded', function() {
    const countElement = document.getElementById('turnos-count');
    const textElement = document.getElementById('turnos-text');
    
    // Función para cargar el contador
    function cargarContador() {
        fetch('/api/turnos/count')
            .then(response => response.json())
            .then(data => {
                countElement.textContent = data.count;
                textElement.textContent = data.count === 1 ? 'Turno registrado' : 'Turnos registrados';
            })
            .catch(error => {
                console.error('Error cargando contador:', error);
                countElement.textContent = '0';
                textElement.textContent = 'Error al cargar';
            });
    }
    
    // Cargar contador al iniciar
    cargarContador();
    
    // Actualizar contador cada 30 segundos
    setInterval(cargarContador, 30000);
});
</script> 